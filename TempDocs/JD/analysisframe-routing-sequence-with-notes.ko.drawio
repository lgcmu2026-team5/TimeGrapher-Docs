        </mxCell>
        <mxCell id="subtitle" value="AnalysisFrame 한 번의 update가 모든 consumer의 관찰 단계와 active graph render 단계로 나뉘어 전달되는 흐름" style="fontFamily=Malgun Gothic;fontSize=15;fontColor=#555555;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="42" y="76" width="1400" height="32" as="geometry" />
