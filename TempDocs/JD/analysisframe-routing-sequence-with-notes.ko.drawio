        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#333333&quot;&gt;흰색 박스&lt;/font&gt; = runtime object/reference&lt;br/&gt;&lt;font color=&quot;#FF6B35&quot;&gt;주황 테두리&lt;/font&gt; = AnalysisFrame DTO&lt;br/&gt;&lt;font color=&quot;#B28A00&quot;&gt;노란 note&lt;/font&gt; = router 내부 field/registry&lt;br/&gt;&lt;font color=&quot;#1565C0&quot;&gt;파란 화살표&lt;/font&gt; = observe/cache update&lt;br/&gt;&lt;font color=&quot;#2E7D32&quot;&gt;초록 화살표&lt;/font&gt; = active graph render" style="fontFamily=Malgun Gothic;fontSize=13;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;strokeWidth=2;strokeColor=#333333;fillColor=#FAFAFA;" vertex="1" parent="1">
