        <mxCell id="title" value="AnalysisFrame Routing Sequence - Router / Consumer / Payload" style="fontFamily=Malgun Gothic;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
