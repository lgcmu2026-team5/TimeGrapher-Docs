        <mxCell id="lifeline_router" value="" style="shape=line;direction=south;html=1;strokeColor=#C9C9C9;strokeWidth=2;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="730" y="234" width="1" height="560" as="geometry" />
