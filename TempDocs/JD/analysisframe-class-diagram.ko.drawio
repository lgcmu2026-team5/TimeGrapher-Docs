        <mxCell id="metricValues" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«record structs»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Metric Value Types&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;BeatTimingSample&lt;br/&gt;AmplitudeSample&lt;br/&gt;DerivedTimingMeasures&lt;br/&gt;AveragePeriodRateInterval" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1140" y="565" width="410" height="135" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;BeatMetricsHistorySnapshot&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ Version: ulong&lt;br/&gt;+ Rate/Amplitude/BeatError: MetricsHistorySeries&lt;br/&gt;+ Derived: DerivedTimingMeasures&lt;br/&gt;+ AveragePeriodRateIntervals: IReadOnlyList&amp;lt;AveragePeriodRateInterval&amp;gt;&lt;br/&gt;+ RateStats/AmplitudeStats: StatsSummary&lt;br/&gt;+ Positions: IReadOnlyList&amp;lt;PositionSummary&amp;gt;&lt;br/&gt;+ PositionChanges: IReadOnlyList&amp;lt;PositionChange&amp;gt;" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1140" y="735" width="410" height="215" as="geometry" />
        </mxCell>
        <mxCell id="segments" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;BeatSegmentsSnapshot&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ Version: ulong&lt;br/&gt;+ Segments: IReadOnlyList&amp;lt;BeatSegment&amp;gt;&lt;br/&gt;+ Markers: IReadOnlyList&amp;lt;BeatNoiseMarker&amp;gt;&lt;br/&gt;+ LiftAngleDeg: double&lt;br/&gt;+ Average: BeatNoiseAverageSnapshot&lt;br/&gt;+ Quality: SignalQualityFlags" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="865" width="430" height="175" as="geometry" />
        </mxCell>
        <mxCell id="pixel" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;PixelBuffer&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ Width: int&lt;br/&gt;+ Height: int&lt;br/&gt;+ Pixels: uint[]&lt;hr/&gt;+ Fill(argb)&lt;br/&gt;+ SetPixel(x, y, argb)&lt;br/&gt;+ GetPixel(x, y): uint&lt;br/&gt;+ Clone(): PixelBuffer" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="585" y="785" width="430" height="205" as="geometry" />
        </mxCell>
        <mxCell id="quality" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«readonly record struct»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;SignalQualityAssessment&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ Class: SignalQualityClass&lt;br/&gt;+ Confidence: float&lt;br/&gt;+ Features: SignalQualityFeatures&lt;br/&gt;+ Unknown: SignalQualityAssessment" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1110" y="940" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;범례 / UML 표기&lt;/b&gt;&lt;br/&gt;◆ = composition: AnalysisFrame이 frame payload로 직접 보유&lt;br/&gt;◇ = aggregation/reference: nullable snapshot 또는 공유 가능한 image/annotation&lt;br/&gt;0..* = 여러 개, 0..1 = 없거나 하나, 1 = 항상 하나&lt;br/&gt;+ public, ~ internal, - private&lt;br/&gt;색상: 주황=중심 class, 초록=setter behavior, 흰색=관련 DTO/value type" style="fontFamily=Malgun Gothic;fontSize=13;whiteSpace=wrap;html=1;rounded=0;strokeColor=#111111;fillColor=#FFFFFF;strokeWidth=2;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="555" y="1015" width="560" height="145" as="geometry" />
        </mxCell>
