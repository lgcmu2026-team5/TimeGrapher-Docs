        <mxCell id="title" value="AnalysisFrame 기준 UML 클래스 다이어그램" style="fontFamily=Malgun Gothic;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="900" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="관점: AnalysisFrame이 한 번의 analysis pass 결과를 어떤 타입들과 함께 UI update 계약으로 묶는지 보여준다." style="fontFamily=Malgun Gothic;fontSize=15;fontColor=#555555;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="42" y="78" width="1320" height="42" as="geometry" />
        </mxCell>
        <mxCell id="analysisFrame" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;AnalysisFrame&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ SessionId: ulong&lt;br/&gt;+ SourceId: ulong&lt;br/&gt;+ SampleRate: int&lt;br/&gt;+ BeatSynced: bool&lt;br/&gt;+ GraphTickEnd: ulong&lt;br/&gt;+ ScopeSeries: IReadOnlyList&amp;lt;GraphSeriesFrame&amp;gt;&lt;br/&gt;+ RateSeries: IReadOnlyList&amp;lt;GraphSeriesFrame&amp;gt;&lt;br/&gt;+ VerticalMarkers: IReadOnlyList&amp;lt;ScopeVerticalMarker&amp;gt;&lt;br/&gt;+ HorizontalMarkers: IReadOnlyList&amp;lt;ScopeHorizontalMarker&amp;gt;&lt;br/&gt;+ TextMarkers: IReadOnlyList&amp;lt;ScopeTextMarker&amp;gt;&lt;br/&gt;+ MetricsUpdate: WatchMetricsUpdate&lt;br/&gt;+ MetricsHistory: BeatMetricsHistorySnapshot?&lt;br/&gt;+ BeatSegments: BeatSegmentsSnapshot?&lt;br/&gt;+ SignalQuality: SignalQualityAssessment?&lt;br/&gt;+ SoundImage: PixelBuffer?&lt;br/&gt;+ SpectrogramImage: PixelBuffer?&lt;hr/&gt;~ AddScopeSeries(series)&lt;br/&gt;~ AddRateSeries(series)&lt;br/&gt;~ SetScopeMarkers(vertical, horizontal, text)&lt;br/&gt;- Replace&amp;lt;T&amp;gt;(target, source)" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=3;strokeColor=#FF6B35;fillColor=#FFF1EA;" vertex="1" parent="1">
          <mxGeometry x="585" y="195" width="430" height="520" as="geometry" />
        </mxCell>
        <mxCell id="graphSeries" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;GraphSeriesFrame&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ Id: string&lt;br/&gt;+ X: IReadOnlyList&amp;lt;double&amp;gt;&lt;br/&gt;+ Y: IReadOnlyList&amp;lt;double&amp;gt;&lt;br/&gt;+ Replace: bool&lt;br/&gt;+ TicPhaseOffsetMs: double" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="360" height="185" as="geometry" />
        </mxCell>
        <mxCell id="markers" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«structs»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Scope Markers&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;ScopeVerticalMarker&lt;br/&gt;  + X, Height, Color&lt;br/&gt;ScopeHorizontalMarker&lt;br/&gt;  + Direction, XLeft, XRight, Length, Height, Color&lt;br/&gt;ScopeTextMarker&lt;br/&gt;  + X, Height, Text, Color, Alignment&lt;br/&gt;HorizontalMarkerDirection, MarkerTextAlignment" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#4F5B62;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="395" width="360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="graphIds" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«static class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;AnalysisGraphSeries&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ ScopePcm, ScopeThreshold&lt;br/&gt;+ RateTic, RateToc&lt;br/&gt;+ SweepTrace&lt;br/&gt;+ FilterF0..FilterF3" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#6D6D6D;fillColor=#F7F7F7;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="metricsUpdate" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;«sealed class»&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px&quot;&gt;&lt;b&gt;WatchMetricsUpdate&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr/&gt;+ XTic/YTic: IReadOnlyList&amp;lt;double&amp;gt;&lt;br/&gt;+ XToc/YToc: IReadOnlyList&amp;lt;double&amp;gt;&lt;br/&gt;+ ResultsText: string&lt;br/&gt;+ CMarkerText: string&lt;br/&gt;+ BeatTimingSample: BeatTimingSample&lt;br/&gt;+ AmplitudeSample: AmplitudeSample&lt;br/&gt;+ DerivedMeasures: DerivedTimingMeasures&lt;br/&gt;+ AveragePeriodRateInterval: AveragePeriodRateInterval&lt;hr/&gt;~ SetTicRate(x, y)&lt;br/&gt;~ SetTocRate(x, y)&lt;br/&gt;~ SetResults(text)&lt;br/&gt;~ SetCMarkerText(text)&lt;br/&gt;~ SetBeatTimingSample(sample)&lt;br/&gt;~ SetAmplitudeSample(sample)&lt;br/&gt;~ SetDerivedMeasures(measures)&lt;br/&gt;~ SetAveragePeriodRateInterval(interval)" style="fontFamily=Malgun Gothic;whiteSpace=wrap;html=1;rounded=0;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;strokeColor=#2E7D32;fillColor=#EEF8F0;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="410" height="390" as="geometry" />
